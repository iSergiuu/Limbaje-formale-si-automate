<Window x:Class="Dfa.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simulator Vizual AFD - Limbaje Formale și Automate" 
        Height="820" Width="1380" WindowStartupLocation="CenterScreen"
        Background="#F7F7F5" FontFamily="Segoe UI">

    <Grid>
        <TabControl Margin="10" Background="White" BorderBrush="#DCDFE4">

            <!-- TAB 1: EDITOR ȘI SIMULATOR DIDACTIC -->
            <TabItem Header=" 🛠️ Editor &amp; Simulator AFD " FontSize="14" FontWeight="SemiBold">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BARA DE SUS (Exemple, Fișiere, Moduri de lucru) -->
                    <Border Grid.Row="0" Background="#F0F1F4" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Exemplu:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbExamples" Width="250" SelectionChanged="CmbExamples_SelectionChanged" Margin="0,0,12,0"/>

                            <Button Content="💾 Salvează JSON" Click="BtnSaveJson_Click" Padding="8,4" Margin="0,0,6,0"/>
                            <Button Content="📂 Încarcă JSON" Click="BtnLoadJson_Click" Padding="8,4" Margin="0,0,16,0"/>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0"/>

                            <TextBlock Text="Unealtă Mouse:" VerticalAlignment="Center" FontWeight="Bold" Margin="8,0,6,0"/>
                            <RadioButton x:Name="RbMove" Content="🖐️ Mută / Selectează" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton x:Name="RbAddState" Content="➕ Adaugă Stare (Click)" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton x:Name="RbAddTransition" Content="↗️ Adaugă Săgeată" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <Button Content="🕸️ + Stare Capcană" Click="BtnTrapState_Click" Padding="8,4" ToolTip="Adaugă o stare capcană pentru toate tranzițiile lipsă"/>
                        </WrapPanel>
                    </Border>

                    <!-- ZONA CENTRALĂ (Stânga: Proprietăți | Mijloc: Desen Canvas | Dreapta: Tabele) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- PANOU STÂNGA: Alfabet și Starea Selectată -->
                        <Border Grid.Column="0" BorderBrush="#DCDFE4" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="1. Alfabetul (Σ)" FontWeight="Bold" FontSize="14" Foreground="#2F5BD3" Margin="0,0,0,4"/>
                                <TextBlock Text="Simboluri separate prin virgulă:" FontSize="12" Foreground="#5D636E"/>
                                <DockPanel Margin="0,4,0,14">
                                    <Button Content="Setează" DockPanel.Dock="Right" Click="BtnSetAlphabet_Click" Padding="8,3" Margin="4,0,0,0"/>
                                    <TextBox x:Name="TxtAlphabet" VerticalContentAlignment="Center" FontWeight="SemiBold"/>
                                </DockPanel>

                                <Separator Margin="0,0,0,10"/>

                                <TextBlock Text="2. Starea Selectată" FontWeight="Bold" FontSize="14" Foreground="#2F5BD3" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtSelectedState" Text="Nicio stare selectată" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                                <CheckBox x:Name="ChkInitial" Content="Este Stare Inițială (→)" Click="ChkInitial_Click" Margin="0,0,0,6" IsEnabled="False"/>
                                <CheckBox x:Name="ChkFinal" Content="Este Stare Finală (* cerc dublu)" Click="ChkFinal_Click" Margin="0,0,0,10" IsEnabled="False"/>

                                <TextBlock Text="Ce «ține minte» starea (descriere):" FontSize="12" Foreground="#5D636E"/>
                                <TextBox x:Name="TxtStateDesc" TextChanged="TxtStateDesc_TextChanged" Height="50" TextWrapping="Wrap" Margin="0,4,0,8" IsEnabled="False"/>

                                <Button x:Name="BtnDeleteState" Content="🗑️ Șterge Starea Selectată" Click="BtnDeleteState_Click" Padding="6,4" IsEnabled="False" Background="#FDECEA" Foreground="#B3261E" BorderBrush="#F5C2C7"/>

                                <Separator Margin="0,14,0,10"/>

                                <TextBlock Text="💡 Cum editezi:" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Text="• Selectează «Adaugă Stare» și dă click pe pânză.&#x0a;• Selectează «Adaugă Săgeată», dă click pe prima stare, apoi pe a doua.&#x0a;• Cu «Mută» poți trage cercurile cu mouse-ul." 
                                           FontSize="11.5" Foreground="#5D636E" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- PANOU MIJLOC: Pânza de desen (Canvas) -->
                        <Border Grid.Column="1" BorderBrush="#DCDFE4" BorderThickness="1" CornerRadius="6" Background="White" ClipToBounds="True">
                            <Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Canvas x:Name="DfaCanvas" Width="1200" Height="700" Background="#FAFAFA"
                                            MouseLeftButtonDown="DfaCanvas_MouseLeftButtonDown"
                                            MouseMove="DfaCanvas_MouseMove"
                                            MouseLeftButtonUp="DfaCanvas_MouseLeftButtonUp"/>
                                </ScrollViewer>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#E8EEFC" CornerRadius="4" Padding="8,4" Margin="10" IsHitTestVisible="False">
                                    <TextBlock x:Name="TxtCanvasHint" Text="Mod curent: Mută / Selectează stări" Foreground="#2F5BD3" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- PANOU DREAPTA: Tabelul δ, Tabelul de Execuție și Testare în lot -->
                        <Grid Grid.Column="2" Margin="8,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="170"/>
                            </Grid.RowDefinitions>

                            <!-- Tabelul funcției de tranziție δ -->
                            <Border Grid.Row="0" BorderBrush="#DCDFE4" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Tabelul de tranziții (δ)" FontWeight="Bold" Foreground="#2F5BD3" Margin="0,0,0,6"/>
                                    <DataGrid x:Name="GridDelta" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" FontSize="12"/>
                                </DockPanel>
                            </Border>

                            <!-- Tabelul de execuție pas cu pas -->
                            <Border Grid.Row="1" BorderBrush="#DCDFE4" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Tabelul de execuție (Pas cu Pas)" FontWeight="Bold" Foreground="#2F5BD3" Margin="0,0,0,6"/>
                                    <DataGrid x:Name="GridExecution" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" FontSize="12">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Pas" Binding="{Binding StepIndex}" Width="40"/>
                                            <DataGridTextColumn Header="Citit" Binding="{Binding ReadSymbol}" Width="50"/>
                                            <DataGridTextColumn Header="Rest" Binding="{Binding RemainingInput}" Width="*"/>
                                            <DataGridTextColumn Header="Stare" Binding="{Binding CurrentState}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <!-- Testare în lot (Batch testing) -->
                            <Border Grid.Row="2" BorderBrush="#DCDFE4" BorderThickness="1" CornerRadius="6" Padding="8">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                        <TextBlock Text="Testare în lot" FontWeight="Bold" Foreground="#2F5BD3" VerticalAlignment="Center"/>
                                        <Button Content="▶ Rulează Lot" DockPanel.Dock="Right" Click="BtnRunBatch_Click" Padding="6,2" FontSize="11"/>
                                        <TextBlock x:Name="TxtBatchSummary" Text="" DockPanel.Dock="Right" Margin="0,0,8,0" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ListBox x:Name="LstBatchTests" FontSize="12" FontFamily="Consolas" MouseDoubleClick="LstBatchTests_MouseDoubleClick" ToolTip="Dublu-click pe un rând pentru a-l încărca în simulator"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- BARA DE JOS: SIMULATORUL (Banda de intrare, Butoanele de pas și Verdictul) -->
                    <Border Grid.Row="2" Background="#F0F1F4" BorderBrush="#DCDFE4" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Controale Simulare -->
                            <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="Cuvânt de intrare:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtInputWord" Width="180" FontSize="14" FontFamily="Consolas" Padding="4,2" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="🚀 Încarcă / Reset" Click="BtnResetSim_Click" Padding="10,4" Margin="0,0,12,0" FontWeight="SemiBold"/>

                                <Button x:Name="BtnStepBack" Content="⏮ Pas Înapoi" Click="BtnStepBack_Click" Padding="10,4" Margin="0,0,6,0"/>
                                <Button x:Name="BtnStepForward" Content="⏭ Pas Înainte" Click="BtnStepForward_Click" Padding="10,4" Margin="0,0,6,0" FontWeight="Bold" Background="#E8EEFC" BorderBrush="#2F5BD3"/>
                                <Button x:Name="BtnPlayPause" Content="▶ Play Automat" Click="BtnPlayPause_Click" Padding="10,4" Margin="0,0,6,0"/>
                                <Button Content="⏩ Până la final" Click="BtnRunToEnd_Click" Padding="10,4" Margin="0,0,16,0"/>

                                <TextBlock Text="Viteză:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider x:Name="SliderSpeed" Minimum="200" Maximum="1500" Value="700" Width="90" VerticalAlignment="Center" ValueChanged="SliderSpeed_ValueChanged"/>
                            </WrapPanel>

                            <!-- Banda de intrare + Verdict -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Bandă:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TapePanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ScrollViewer>

                                <Border x:Name="BorderVerdict" Grid.Column="2" CornerRadius="6" Padding="14,6" Background="#E8EEFC" Margin="12,0,0,0">
                                    <TextBlock x:Name="TxtVerdict" Text="Pregătit pentru simulare." FontWeight="Bold" FontSize="13" Foreground="#2F5BD3"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: APLICAȚIA REALĂ (NUMERE DE ÎNMATRICULARE ROMÂNEȘTI) -->
            <TabItem Header=" 🚗 Aplicație Reală: Validator Număr Înmatriculare (A1) " FontSize="14" FontWeight="SemiBold">
                <Grid Margin="30">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBlock Text="Validator Numere de Înmatriculare Românești" FontSize="24" FontWeight="Bold" Foreground="#2F5BD3" Margin="0,0,0,8"/>
                        <TextBlock Text="Acest ecran folosește în spate exact același motor AFD (Dfa.Core) și același fișier de automat ca simulatorul didactic. Tastează un număr mai jos pentru a-l verifica live, caracter cu caracter!" 
                                   TextWrapping="Wrap" Foreground="#5D636E" FontSize="14" Margin="0,0,0,24"/>

                        <!-- Plăcuța de înmatriculare stilizată -->
                        <Border BorderBrush="#1D1F23" BorderThickness="4" CornerRadius="10" Background="White" Height="110" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#003399" CornerRadius="5,0,0,5">
                                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,10">
                                        <TextBlock Text="★" Foreground="#FFCC00" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="RO" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBox x:Name="TxtLicensePlate" Grid.Column="1" FontSize="46" FontWeight="Bold" FontFamily="Consolas"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="0"
                                         CharacterCasing="Upper" MaxLength="10" Text="B 123 ABC"
                                         TextChanged="TxtLicensePlate_TextChanged"/>
                            </Grid>
                        </Border>

                        <!-- Caseta de status live -->
                        <Border x:Name="PlateStatusBorder" CornerRadius="8" Padding="18" Background="#E3F4EA" BorderBrush="#1F7A4C" BorderThickness="2" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock x:Name="TxtPlateVerdict" Text="✓ FORMAT VALID" FontSize="18" FontWeight="Bold" Foreground="#1F7A4C" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtPlateStateHint" Text="Stare curentă: q_ok — Număr de înmatriculare VALID!" FontSize="14" Foreground="#1D1F23"/>
                            </StackPanel>
                        </Border>

                        <Button Content="🔍 Deschide acest număr și automatul în Simulatorul Pas cu Pas" Click="BtnOpenPlateInSim_Click" 
                                Padding="14,10" FontSize="14" FontWeight="Bold" Background="#2F5BD3" Foreground="White" HorizontalAlignment="Left"/>

                        <Border Background="#F0F1F4" CornerRadius="8" Padding="16" Margin="0,28,0,0">
                            <StackPanel>
                                <TextBlock Text="Exemple rapide de încercat (Click pe ele):" FontWeight="Bold" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="B 123 ABC (Valid)" Click="BtnQuickPlate_Click" Tag="B 123 ABC" Margin="0,0,8,8" Padding="8,4"/>
                                    <Button Content="AG 07 XYZ (Valid)" Click="BtnQuickPlate_Click" Tag="AG 07 XYZ" Margin="0,0,8,8" Padding="8,4"/>
                                    <Button Content="CJ 12 ABC (Valid)" Click="BtnQuickPlate_Click" Tag="CJ 12 ABC" Margin="0,0,8,8" Padding="8,4"/>
                                    <Button Content="CJ 123 ABC (Respins - 3 cifre)" Click="BtnQuickPlate_Click" Tag="CJ 123 ABC" Margin="0,0,8,8" Padding="8,4"/>
                                    <Button Content="B 12 (Incomplet)" Click="BtnQuickPlate_Click" Tag="B 12 " Margin="0,0,8,8" Padding="8,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>